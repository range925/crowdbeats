rules_version = '2';

// Crowdbeats V2 — Firestore Security Rules (Phase 3 — Trust Foundation)
//
// Security Auditor Target Score: 5/5 (Secure)
//
// ARCHITECTURE INVARIANTS:
// 1. Default-deny: all paths not explicitly listed are denied
// 2. No client-writable balance, ledger, payout, or audit fields
// 3. Role self-assignment is impossible (roles sourced from Firestore by server only)
// 4. Server-only collections: /paymentLedger, /paymentTransactions, /payouts,
//    /idempotencyKeys, /auditEvents, /fraudSignals
// 5. All financial totals (totalTipsReceivedCents etc.) are server-maintained
// 6. No rule relies solely on user-provided data for role authorization
// 7. Type checking enforced on all writable fields
// 8. String length limits enforced to prevent DoS/resource exhaustion
// 9. Optimistic concurrency (v field) enforced on high-risk documents
// 10. Soft-delete: deletedAt field can only be set by server (SUPER_ADMIN callable)

service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ══════════════════════════════════════════════════════════════════════════

    // ── Auth helpers ──────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(resourceUid) {
      return isSignedIn() && uid() == resourceUid;
    }

    // ── Custom claims helpers ─────────────────────────────────────────────────

    function claims() {
      return request.auth.token;
    }

    function platformRole() {
      return claims().get('platformRole', null);
    }

    function hasPlatformRole(role) {
      return isSignedIn() && platformRole() == role;
    }

    function isSuperAdmin() {
      return hasPlatformRole('SUPER_ADMIN');
    }

    // Staff roles that can read user profiles (non-PII limited fields)
    function isUserSupportStaff() {
      return isSignedIn() && platformRole() in [
        'SUPER_ADMIN', 'CUSTOMER_SUPPORT', 'TRUST_SAFETY',
        'COMPLIANCE_OFFICER', 'CONTENT_MODERATOR'
      ];
    }

    function isFinanceStaff() {
      return isSignedIn() && platformRole() in [
        'SUPER_ADMIN', 'FINANCE_ANALYST', 'EXECUTIVE'
      ];
    }

    function isModerationStaff() {
      return isSignedIn() && platformRole() in [
        'SUPER_ADMIN', 'CONTENT_MODERATOR', 'TRUST_SAFETY'
      ];
    }

    // ── Membership helpers (read from Firestore) ──────────────────────────────

    // Check if the current user is an active member of a band with at least the given role.
    // Role hierarchy: BAND_FOUNDER > BAND_ADMIN > BAND_MEMBER
    function isBandMember(bandId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/bands/$(bandId)/members/$(uid())) &&
        get(/databases/$(database)/documents/bands/$(bandId)/members/$(uid())).data.isActive == true;
    }

    function isBandAdmin(bandId) {
      return isBandMember(bandId) &&
        get(/databases/$(database)/documents/bands/$(bandId)/members/$(uid())).data.role
          in ['BAND_FOUNDER', 'BAND_ADMIN'];
    }

    function isVenueMember(venueId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/venueProfiles/$(venueId)/members/$(uid())) &&
        get(/databases/$(database)/documents/venueProfiles/$(venueId)/members/$(uid())).data.isActive == true;
    }

    function isVenueManager(venueId) {
      return isVenueMember(venueId) &&
        get(/databases/$(database)/documents/venueProfiles/$(venueId)/members/$(uid())).data.role
          in ['VENUE_OWNER', 'VENUE_MANAGER'];
    }

    function isSponsorMember(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/sponsorOrgs/$(orgId)/members/$(uid())) &&
        get(/databases/$(database)/documents/sponsorOrgs/$(orgId)/members/$(uid())).data.isActive == true;
    }

    function isSponsorAdmin(orgId) {
      return isSponsorMember(orgId) &&
        get(/databases/$(database)/documents/sponsorOrgs/$(orgId)/members/$(uid())).data.role
          == 'SPONSOR_ADMIN';
    }

    // ── Blocking & Safety helpers (bidirectional check) ──────────────────────
    // Returns true if either user/entity has blocked the other.
    function isBlocked(userA, userB) {
      return (userA != null && userB != null) && (
        exists(/databases/$(database)/documents/users/$(userA)/blockedUsers/$(userB)) ||
        exists(/databases/$(database)/documents/users/$(userB)/blockedUsers/$(userA)) ||
        exists(/databases/$(database)/documents/socialBlocks/$(userA + '_' + userB)) ||
        exists(/databases/$(database)/documents/socialBlocks/$(userB + '_' + userA))
      );
    }

    // Directed restriction check (did restricter restrict target?)
    function isSociallyRestricted(restricterId, restrictedId) {
      return (restricterId != null && restrictedId != null) &&
        exists(/databases/$(database)/documents/socialRestrictions/$(restricterId + '_' + restrictedId));
    }

    // Validates whether the authenticated caller is authorized to act on behalf of an entity
    function isSocialEntityOperator(entityId, entityType) {
      return isSignedIn() && (
        (entityType in ['fan', 'artist'] && entityId == uid()) ||
        (entityType == 'band' && isBandMember(entityId))
      );
    }

    // Validates whether caller is an admin of the entity (for safety / membership actions)
    function isSocialEntityAdmin(entityId, entityType) {
      return isSignedIn() && (
        (entityType in ['fan', 'artist'] && entityId == uid()) ||
        (entityType == 'band' && isBandAdmin(entityId))
      );
    }

    // Conversation participant validation (fan/artist directly or band via active membership)
    function isConversationParticipant(convData) {
      return isSignedIn() && (
        uid() in convData.participantIds ||
        (convData.get('participantTypes', {})[convData.participantIds[0]] == 'band' && isBandMember(convData.participantIds[0])) ||
        (convData.get('participantTypes', {})[convData.participantIds[1]] == 'band' && isBandMember(convData.participantIds[1]))
      );
    }

    // ── Field validation helpers ───────────────────────────────────────────────

    function isString(val) { return val is string; }

    function validDisplayName(name) {
      return isString(name) && name.size() >= 2 && name.size() <= 50;
    }

    function validUrl(url) {
      return isString(url) && url.matches('https://.*');
    }

    function validBio(bio, maxLen) {
      return isString(bio) && bio.size() <= maxLen;
    }

    // ── Immutable field guard ──────────────────────────────────────────────────

    // Ensure that fields listed as immutable after creation are not changed on update.
    function immutableOnUpdate(fields) {
      return !(request.resource.data.diff(resource.data).affectedKeys().hasAny(fields));
    }

    // ══════════════════════════════════════════════════════════════════════════
    // USER RECORDS — /users/{uid}
    // ══════════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      // Owner reads own full doc; support staff can read (non-PII check in app layer)
      allow read: if isOwner(userId) || isUserSupportStaff();

      // Allow user document creation by the owner (handles onCreateUser latency / client fallback)
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (request.resource.data.get('personaType', null) == null ||
          request.resource.data.personaType in ['fan', 'artist', 'band_member', 'venue_manager', 'sponsor_rep']) &&
        // Cannot self-assign platform admin roles, stripe accounts, compliance holds, or suspension fields
        request.resource.data.get('platformRole', null) == null &&
        request.resource.data.get('complianceHold', null) == null &&
        request.resource.data.get('suspendedAt', null) == null &&
        request.resource.data.get('deletedAt', null) == null &&
        request.resource.data.get('stripeConnectAccountId', null) == null &&
        request.resource.data.get('stripeCustomerId', null) == null &&
        request.resource.data.get('payoutHoldReason', null) == null;

      // Owner can update profile and persona fields during onboarding / profile editing.
      allow update: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (!('v' in request.resource.data) || request.resource.data.v >= resource.data.get('v', 0)) &&
        (request.resource.data.get('personaType', null) == null ||
          request.resource.data.personaType in ['fan', 'artist', 'band_member', 'venue_manager', 'sponsor_rep']) &&
        (resource.data.get('personaType', null) == null ||
          request.resource.data.get('personaType', null) == resource.data.personaType) &&
        // Cannot self-assign platform admin roles, stripe accounts, compliance holds, or suspension fields
        immutableOnUpdate([
          'email', 'createdAt', 'deletedAt', 'suspendedAt',
          'platformRole', 'stripeCustomerId',
          'stripeConnectAccountId', 'complianceHold', 'payoutHoldReason'
        ]);

      // No direct deletes — soft-delete only via SUPER_ADMIN callable
      allow delete: if false;

      // ── Consents (subcollection) ───────────────────────────────────────────
      match /consents/{consentId} {
        allow read: if isOwner(userId) || hasPlatformRole('COMPLIANCE_OFFICER') || isSuperAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }

      // ── Settings (subcollection) ───────────────────────────────────────────
      match /settings/{settingDoc} {
        allow read, write: if isOwner(userId);
      }

      // ── Consent Receipts — Phase 2 (audience visibility) ──────────────────
      // Fan's own record of their audience consent decisions.
      // Readable by the fan only (GDPR/CCPA data export).
      // Written by grantAudienceVisibility callable (Admin SDK).
      // Creator CANNOT read — this collection provides no cross-reference to grants.
      match /consentReceipts/{receiptId} {
        allow read: if isOwner(userId);
        // No direct client writes — callable only
        allow create, update, delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // FAN PROFILES — /fanProfiles/{uid}
    // ══════════════════════════════════════════════════════════════════════════

    match /fanProfiles/{fanUid} {
      allow read: if isOwner(fanUid) || isUserSupportStaff();
      allow create: if isOwner(fanUid);

      allow update: if isOwner(fanUid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['bio', 'photoUrl', 'displayName', 'favoriteGenres', 'interests', 'updatedAt', 'v']
        ) &&
        (request.resource.data.get('bio', null) == null || validBio(request.resource.data.bio, 300)) &&
        // Server-only fields must not be changed
        immutableOnUpdate(['uid', 'totalTippedCents', 'createdAt']);

      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ARTIST PROFILES — /artistProfiles/{artistId}
    // ══════════════════════════════════════════════════════════════════════════

    match /artistProfiles/{artistId} {
      // Public read of non-sensitive fields — app layer filters fields
      allow read: if isSignedIn() || resource.data.get('isActive', false) == true;

      allow create: if isSignedIn() && (
        request.resource.data.get('ownerUid', '') == uid() ||
        request.resource.data.get('artistId', '') == uid() ||
        artistId == uid()
      ) && !request.resource.data.keys().hasAny([
        'availableBalanceCents', 'totalTipsReceivedCents', 'totalPaidOutCents', 'tipCount',
        'stripeAccountId', 'stripeConnectAccountId', 'bankLinked', 'verifiedAt',
        'chargesEnabled', 'isSuspended', 'suspendedAt', 'complianceHold', 'payoutHoldReason',
        'monetizationStatus', 'isDemonetized', 'stripeChargesEnabled'
      ]);

      // Owner (or band founder in band context) can update profile fields
      allow update: if isSignedIn() && (
        (resource.data.get('ownerUid', '') == uid()) ||
        artistId == uid()
      ) &&
        immutableOnUpdate([
          'artistId', 'ownerUid', 'createdAt', 'totalTipsReceivedCents',
          'availableBalanceCents', 'totalPaidOutCents', 'tipCount',
          'stripeAccountId', 'stripeConnectAccountId', 'bankLinked', 'verifiedAt',
          'chargesEnabled', 'isSuspended', 'suspendedAt', 'complianceHold', 'payoutHoldReason',
          'monetizationStatus', 'isDemonetized', 'stripeChargesEnabled'
        ]);

      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // BANDS — /bands/{bandId}
    // ══════════════════════════════════════════════════════════════════════════

    match /bands/{bandId} {
      // Members can read their band; public can read active bands
      allow read: if isBandMember(bandId) || resource.data.get('isActive', true) == true || isSignedIn();

      allow create: if isSignedIn() && (
        request.resource.data.get('founderUid', '') == uid() ||
        bandId == uid()
      ) && !request.resource.data.keys().hasAny([
        'totalTipsReceivedCents', 'availableBalanceCents', 'totalPaidOutCents', 'tipCount',
        'stripeAccountId', 'bankLinked', 'isSuspended', 'suspendedAt',
        'complianceHold', 'payoutHoldReason', 'monetizationStatus', 'isDemonetized'
      ]);

      // Band admin/founder can update non-financial fields
      allow update: if (isBandAdmin(bandId) || (
        isSignedIn() && (
          resource.data.get('founderUid', '') == uid() ||
          bandId == uid()
        )
      )) &&
        immutableOnUpdate([
          'bandId', 'founderUid', 'createdAt', 'totalTipsReceivedCents',
          'availableBalanceCents', 'totalPaidOutCents', 'tipCount',
          'stripeAccountId', 'bankLinked', 'isSuspended', 'suspendedAt',
          'complianceHold', 'payoutHoldReason', 'monetizationStatus', 'isDemonetized'
        ]);

      allow delete: if false;

      // ── Band Members (subcollection) ───────────────────────────────────────
      match /members/{memberId} {
        allow read: if isBandMember(bandId) || isUserSupportStaff();
        // Members added/removed via callable only
        allow create, update, delete: if false;
      }

      // ── Split Config (subcollection) — SERVER_ONLY WRITE ──────────────────
      match /splitConfig/{configDoc} {
        // Members can read split config to see their share
        allow read: if isBandMember(bandId);
        // NO client may write split config — server only via callable
        allow create, update, delete: if false;
      }

      // ── Split History (subcollection) — SERVER_ONLY WRITE ────────────────
      match /splitHistory/{versionDoc} {
        allow read: if isBandMember(bandId);
        allow create, update, delete: if false;
      }

      // ── Invitations (subcollection) ───────────────────────────────────────
      match /invitations/{invitationId} {
        allow read: if isBandAdmin(bandId) ||
          (isSignedIn() && request.auth.token.get('email', '').lower() == resource.data.get('inviteeEmail', '').lower());
        allow create, update, delete: if false;
      }

      // ── Audit Logs (subcollection) ────────────────────────────────────────
      match /auditLogs/{logId} {
        allow read: if isBandAdmin(bandId) || isSuperAdmin();
        allow create, update, delete: if false;
      }
    }

    // ── Top-level Invitations Index ─────────────────────────────────────────
    match /invitations/{invitationId} {
      allow read: if isSignedIn() &&
        (request.auth.token.get('email', '').lower() == resource.data.get('inviteeEmail', '').lower() ||
         isBandAdmin(resource.data.get('bandId', '')) ||
         isVenueManager(resource.data.get('venueId', '')) ||
         isSponsorAdmin(resource.data.get('orgId', '')));
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // VENUE PROFILES — /venueProfiles/{venueId}
    // ══════════════════════════════════════════════════════════════════════════

    match /venueProfiles/{venueId} {
      // Public read of active venues for discovery; managers/staff have full access
      allow read: if isSignedIn() || resource.data.get('isActive', true) == true;

      allow create: if isSignedIn() && (
        request.resource.data.get('ownerUid', '') == uid() ||
        venueId == uid()
      ) && !request.resource.data.keys().hasAny([
        'bankLinked', 'verifiedAt'
      ]);

      allow update: if (isVenueManager(venueId) || (
        isSignedIn() && (
          resource.data.get('ownerUid', '') == uid() ||
          venueId == uid()
        )
      )) &&
        immutableOnUpdate(['venueId', 'ownerUid', 'createdAt', 'bankLinked', 'verifiedAt']);

      allow delete: if false;

      match /members/{memberId} {
        allow read: if isVenueMember(venueId) || isUserSupportStaff();
        allow create, update, delete: if false;
      }

      match /invitations/{invitationId} {
        allow read: if isVenueManager(venueId) ||
          (isSignedIn() && request.auth.token.get('email', '').lower() == resource.data.get('inviteeEmail', '').lower());
        allow create, update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if isVenueManager(venueId) || isSuperAdmin();
        allow create, update, delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SPONSOR ORGANIZATIONS — /sponsorOrgs/{orgId}
    // ══════════════════════════════════════════════════════════════════════════

    match /sponsorOrgs/{orgId} {
      allow read: if isSponsorMember(orgId) || isSignedIn();

      allow create: if isSignedIn() && (
        request.resource.data.get('ownerUid', '') == uid() ||
        request.resource.data.get('adminUid', '') == uid() ||
        orgId == uid()
      ) && !request.resource.data.keys().hasAny([
        'isVerified', 'totalEscrowDepositedCents'
      ]);

      allow update: if (isSponsorAdmin(orgId) || (
        isSignedIn() && (
          resource.data.get('ownerUid', '') == uid() ||
          resource.data.get('adminUid', '') == uid() ||
          orgId == uid()
        )
      )) &&
        immutableOnUpdate(['orgId', 'ownerUid', 'adminUid', 'createdAt', 'isVerified', 'totalEscrowDepositedCents']);

      allow delete: if false;

      match /members/{memberId} {
        allow read: if isSponsorMember(orgId) || isUserSupportStaff();
        allow create, update, delete: if false;
      }

      match /invitations/{invitationId} {
        allow read: if isSponsorAdmin(orgId) ||
          (isSignedIn() && request.auth.token.get('email', '').lower() == resource.data.get('inviteeEmail', '').lower());
        allow create, update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if isSponsorAdmin(orgId) || isSuperAdmin();
        allow create, update, delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // STAFF RECORDS — /staffRecords/{uid}
    // ══════════════════════════════════════════════════════════════════════════

    match /staffRecords/{staffUid} {
      // Only SUPER_ADMIN can read/write staff records
      allow read: if isOwner(staffUid) || isSuperAdmin();
      allow create, update, delete: if false; // Via grantStaffRole callable (SUPER_ADMIN step-up)
    }

    // ══════════════════════════════════════════════════════════════════════════
    // STAGES — /stages/{stageId}
    // ══════════════════════════════════════════════════════════════════════════

    match /stages/{stageId} {
      allow read: if isSignedIn() || resource.data.get('isActive', true) == true;
      // Created and managed by venue managers via callable
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // STAGE SESSIONS — /stageSessions/{sessionId}
    // ══════════════════════════════════════════════════════════════════════════

    match /stageSessions/{sessionId} {
      // Public visitors, fans and artists can read active or scheduled sessions for discovery
      allow read: if isSignedIn() || resource.data.get('status', '') in ['ACTIVE', 'SCHEDULED'];
      // All writes via server callable only (createSession, startSession, endSession)
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // QR TOKENS — /qrTokens/{tokenId}  — SERVER_ONLY
    // ══════════════════════════════════════════════════════════════════════════

    match /qrTokens/{tokenId} {
      // No client reads or writes — issued and verified exclusively by Cloud Functions
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // TIPS — /tips/{tipId}
    // ══════════════════════════════════════════════════════════════════════════

    match /tips/{tipId} {
      // Fan reads own tips; recipient reads tips received; staff can read
      allow read: if isSignedIn() &&
        (resource.data.fanUid == uid() ||
         resource.data.recipientId == uid() ||
         isUserSupportStaff());

      // Tips are SERVER-CREATED ONLY — no client writes ever
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CAMPAIGN CONTRIBUTIONS — /contributions/{contributionId}
    // ══════════════════════════════════════════════════════════════════════════

    match /contributions/{contributionId} {
      allow read: if isSignedIn() &&
        (resource.data.fanUid == uid() || isUserSupportStaff());
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PAYMENT TRANSACTIONS — SERVER_ONLY
    // ══════════════════════════════════════════════════════════════════════════

    match /paymentTransactions/{txId} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PAYMENT LEDGER — SERVER_ONLY, IMMUTABLE
    // ══════════════════════════════════════════════════════════════════════════

    match /paymentLedger/{entryId} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PAYOUTS — /payouts/{payoutId}
    // ══════════════════════════════════════════════════════════════════════════

    match /payouts/{payoutId} {
      // Creator reads own payout records only
      allow read: if isSignedIn() &&
        (resource.data.recipientId == uid() || isFinanceStaff());
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // IDEMPOTENCY KEYS — SERVER_ONLY
    // ══════════════════════════════════════════════════════════════════════════

    match /idempotencyKeys/{key} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CAMPAIGNS — /campaigns/{campaignId}
    // ══════════════════════════════════════════════════════════════════════════

    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create: if false; // Via createCampaign callable
      allow update: if isSignedIn() && resource.data.creatorId == uid() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['title', 'description', 'coverUrl', 'updatedAt', 'v']
        ) &&
        request.resource.data.v == resource.data.v + 1 &&
        immutableOnUpdate(['campaignId', 'creatorId', 'creatorType', 'goalAmountCents',
          'currency', 'raisedAmountCents', 'contributionCount', 'createdAt']);
      allow delete: if false;

      match /rewards/{rewardId} {
        allow read: if isSignedIn();
        allow create, update, delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SPONSORSHIPS — /sponsorships/{sponsorshipId}
    // ══════════════════════════════════════════════════════════════════════════

    match /sponsorships/{sponsorshipId} {
      allow read: if isSignedIn() &&
        (resource.data.recipientId == uid() ||
         isSponsorMember(resource.data.orgId) ||
         hasPlatformRole('PARTNERSHIPS') ||
         isSuperAdmin());
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // MATCH POOLS — /matchPools/{poolId}
    // ══════════════════════════════════════════════════════════════════════════

    match /matchPools/{poolId} {
      allow read: if isSignedIn() &&
        (resource.data.recipientId == uid() ||
         isSponsorMember(resource.data.orgId) ||
         isSuperAdmin());
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // NOTIFICATIONS — /notifications/{uid}/items/{notifId}
    // ══════════════════════════════════════════════════════════════════════════

    match /notifications/{notifUid}/items/{notifId} {
      allow read: if isOwner(notifUid);
      allow update: if isOwner(notifUid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // REPORTS — /reports/{reportId} (Phase 6 / Phase 12)
    // Ingested via submitReport callable only (IP hashing, SLA classification)
    // ══════════════════════════════════════════════════════════════════════════

    match /reports/{reportId} {
      // Reporter can read own report; moderation staff & super admin can read all
      allow read: if (isSignedIn() && resource.data.reporterUid == uid()) || isModerationStaff() || isSuperAdmin();
      // All creation/mutations via server callable only
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // MODERATION QUEUE — /moderationQueue/{itemId} (Phase 5 / Phase 12)
    // ══════════════════════════════════════════════════════════════════════════

    match /moderationQueue/{itemId} {
      allow read, write: if isModerationStaff() || isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // DISCIPLINARY STRIKES — /strikes/{strikeId} (Phase 7 / Phase 12)
    // ══════════════════════════════════════════════════════════════════════════

    match /strikes/{strikeId} {
      allow read: if (isSignedIn() && resource.data.targetUid == uid()) || isModerationStaff() || isSuperAdmin();
      allow create, update, delete: if false; // Server-managed only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PAYOUT HOLDS — /payoutHolds/{holdId} (Phase 9 / Phase 12)
    // ══════════════════════════════════════════════════════════════════════════

    match /payoutHolds/{holdId} {
      allow read: if (isSignedIn() && resource.data.creatorId == uid()) || isModerationStaff() || isFinanceStaff() || isSuperAdmin();
      allow create, update, delete: if false; // Server-managed only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // DISPUTES & CHARGEBACKS — /disputes/{disputeId} (Phase 11 / Phase 12)
    // ══════════════════════════════════════════════════════════════════════════

    match /disputes/{disputeId} {
      allow read: if (isSignedIn() && resource.data.recipientId == uid()) || isModerationStaff() || isFinanceStaff() || isSuperAdmin();
      allow create, update, delete: if false; // Webhook & Server-managed only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // COMPLIANCE CONSENT REGISTRY — /complianceConsent/{consentId} (Phase 4 / Phase 12)
    // ══════════════════════════════════════════════════════════════════════════

    match /complianceConsent/{consentId} {
      allow read: if (isSignedIn() && resource.data.uid == uid()) || hasPlatformRole('COMPLIANCE_OFFICER') || isSuperAdmin();
      allow create, update, delete: if false; // Server-managed via recordConsent callable only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // USER ONBOARDING CONSENTS — /consent/{consentId}
    // ══════════════════════════════════════════════════════════════════════════

    match /consent/{consentId} {
      allow read: if (isSignedIn() && resource.data.uid == uid()) || hasPlatformRole('COMPLIANCE_OFFICER') || isSuperAdmin();
      allow create, update: if isSignedIn() &&
        request.resource.data.uid == uid() &&
        request.resource.data.consentType is string &&
        request.resource.data.granted == true;
      allow delete: if false; // Consents are immutable audit logs
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CREATOR SLUGS REGISTRY — /creatorSlugs/{slug} (Phase 2 / Phase 12)
    // ══════════════════════════════════════════════════════════════════════════

    match /creatorSlugs/{slug} {
      allow read: if true; // Public directory resolution
      allow create, update, delete: if false; // Cloud Functions transactional registration only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // WEBHOOK EVENTS & STRIPE LOGS — SERVER_ONLY (Phase 10 & Phase 15)
    // ══════════════════════════════════════════════════════════════════════════

    match /webhookEvents/{eventId} {
      allow read, write: if false; // Cloud Functions only
    }

    match /stripeWebhookEvents/{eventId} {
      allow read: if isFinanceStaff() || isSuperAdmin();
      allow create, update, delete: if false; // Server-only webhook ingestion
    }

    // ══════════════════════════════════════════════════════════════════════════
    // POLICY ACCEPTANCES & LEGAL CONSENTS — /policyAcceptances/{acceptanceId}
    // ══════════════════════════════════════════════════════════════════════════

    match /policyAcceptances/{acceptanceId} {
      allow read: if (isSignedIn() && resource.data.userId == uid()) || hasPlatformRole('COMPLIANCE_OFFICER') || isSuperAdmin();
      allow create, update, delete: if false; // Server-managed via recordConsent callable only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CONTENT REPORTS & RIGHTS HOLDER REPORTS — (Phase 9 & Phase 10)
    // ══════════════════════════════════════════════════════════════════════════

    match /contentReports/{reportId} {
      allow read: if isModerationStaff() || isSuperAdmin();
      allow create, update, delete: if false; // Via submitReport / submitCopyrightReport callables only
    }

    match /rightsHolderReports/{reportId} {
      allow read: if hasPlatformRole('COMPLIANCE_OFFICER') || hasPlatformRole('TRUST_SAFETY') || isSuperAdmin();
      allow create, update, delete: if false; // Via submitCopyrightReport callable only
    }

    match /moderationAppeals/{appealId} {
      allow read: if (isSignedIn() && resource.data.creatorId == uid()) || isModerationStaff() || isSuperAdmin();
      allow create, update, delete: if false; // Via submitAppeal callable only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // MODERATION ACTIONS — /moderationActions/{actionId} — STAFF_ONLY writes
    // ══════════════════════════════════════════════════════════════════════════

    match /moderationActions/{actionId} {
      allow read: if isModerationStaff() || isSuperAdmin();
      allow create, update, delete: if false; // Via callable only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // FRAUD SIGNALS — SERVER_ONLY
    // ══════════════════════════════════════════════════════════════════════════

    match /fraudSignals/{signalId} {
      allow read: if isSignedIn() && platformRole() in [
        'SUPER_ADMIN', 'TRUST_SAFETY', 'FINANCE_ANALYST'
      ];
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // AUDIT LOGS & EVENTS — SERVER_ONLY, IMMUTABLE, APPEND-ONLY (Phase 0-12)
    // ══════════════════════════════════════════════════════════════════════════

    match /auditLogs/{logId} {
      allow read: if hasPlatformRole('COMPLIANCE_OFFICER') || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if hasPlatformRole('COMPLIANCE_OFFICER') || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // FOLLOWS — /follows/{followId}
    // Supports multi-entity (sourceId_targetId) and legacy (fanUid_artistId)
    // ══════════════════════════════════════════════════════════════════════════

    match /follows/{followId} {
      allow read: if isSignedIn() && (
        resource.data.get('sourceId', null) == uid() ||
        resource.data.get('targetId', null) == uid() ||
        resource.data.get('fanUid', null) == uid() ||
        resource.data.get('artistId', null) == uid() ||
        (resource.data.get('sourceType', null) == 'band' && isBandMember(resource.data.sourceId)) ||
        (resource.data.get('targetType', null) == 'band' && isBandMember(resource.data.targetId)) ||
        !isBlocked(resource.data.get('sourceId', resource.data.get('fanUid', null)), uid())
      );

      allow create: if isSignedIn() && emailVerified() && (
        (
          request.resource.data.keys().hasAll(['sourceId', 'sourceType', 'targetId', 'targetType', 'operatorUid']) &&
          followId == request.resource.data.sourceId + '_' + request.resource.data.targetId &&
          request.resource.data.sourceId != request.resource.data.targetId &&
          request.resource.data.operatorUid == uid() &&
          isSocialEntityAdmin(request.resource.data.sourceId, request.resource.data.sourceType) &&
          request.resource.data.sourceType in ['fan', 'artist', 'band'] &&
          request.resource.data.targetType in ['fan', 'artist', 'band'] &&
          !isBlocked(request.resource.data.sourceId, request.resource.data.targetId) &&
          !request.resource.data.keys().hasAny(['followerCount', 'followingCount', 'totalTipsReceivedCents'])
        ) ||
        (
          request.resource.data.fanUid == uid() &&
          isString(request.resource.data.artistId) &&
          request.resource.data.artistId.size() > 0 &&
          followId == uid() + '_' + request.resource.data.artistId &&
          !isBlocked(uid(), request.resource.data.artistId) &&
          !request.resource.data.keys().hasAny(['followerCount', 'totalTipsReceivedCents'])
        )
      );

      // Unfollow (source) OR Remove Follower (target)
      allow delete: if isSignedIn() && (
        resource.data.get('fanUid', null) == uid() ||
        (resource.data.get('sourceId', null) != null && isSocialEntityAdmin(resource.data.sourceId, resource.data.get('sourceType', 'fan'))) ||
        (resource.data.get('targetId', null) != null && isSocialEntityAdmin(resource.data.targetId, resource.data.get('targetType', 'artist'))) ||
        isSuperAdmin()
      );

      allow update: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SOCIAL BLOCKS — /socialBlocks/{blockId}
    // Compound ID: {blockerId}_{blockedId}
    // ══════════════════════════════════════════════════════════════════════════

    match /socialBlocks/{blockId} {
      allow read: if isSignedIn() && (
        (resource.data.blockerType in ['fan', 'artist'] && resource.data.blockerId == uid()) ||
        (resource.data.blockerType == 'band' && isBandAdmin(resource.data.blockerId)) ||
        isModerationStaff() ||
        isSuperAdmin()
      );

      allow create: if isSignedIn() && emailVerified() &&
        blockId == request.resource.data.blockerId + '_' + request.resource.data.blockedId &&
        request.resource.data.blockerId != request.resource.data.blockedId &&
        request.resource.data.operatorUid == uid() &&
        isSocialEntityAdmin(request.resource.data.blockerId, request.resource.data.blockerType) &&
        request.resource.data.blockerType in ['fan', 'artist', 'band'] &&
        request.resource.data.blockedType in ['fan', 'artist', 'band'];

      allow delete: if isSignedIn() && (
        (resource.data.blockerType in ['fan', 'artist'] && resource.data.blockerId == uid()) ||
        (resource.data.blockerType == 'band' && isBandAdmin(resource.data.blockerId)) ||
        isSuperAdmin()
      );

      allow update: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SOCIAL RESTRICTIONS — /socialRestrictions/{restrictId}
    // Compound ID: {restricterId}_{restrictedId}
    // ══════════════════════════════════════════════════════════════════════════

    match /socialRestrictions/{restrictId} {
      allow read: if isSignedIn() && (
        (resource.data.restricterType in ['fan', 'artist'] && resource.data.restricterId == uid()) ||
        (resource.data.restricterType == 'band' && isBandAdmin(resource.data.restricterId)) ||
        isModerationStaff() ||
        isSuperAdmin()
      );

      allow create: if isSignedIn() && emailVerified() &&
        restrictId == request.resource.data.restricterId + '_' + request.resource.data.restrictedId &&
        request.resource.data.restricterId != request.resource.data.restrictedId &&
        request.resource.data.operatorUid == uid() &&
        isSocialEntityAdmin(request.resource.data.restricterId, request.resource.data.restricterType) &&
        request.resource.data.restricterType in ['fan', 'artist', 'band'] &&
        request.resource.data.restrictedType in ['fan', 'artist', 'band'];

      allow delete: if isSignedIn() && (
        (resource.data.restricterType in ['fan', 'artist'] && resource.data.restricterId == uid()) ||
        (resource.data.restricterType == 'band' && isBandAdmin(resource.data.restricterId)) ||
        isSuperAdmin()
      );

      allow update: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CONVERSATIONS — /conversations/{conversationId}
    // Deterministic ID: conv_{idA}_{idB} (sorted)
    // ══════════════════════════════════════════════════════════════════════════

    match /conversations/{conversationId} {
      allow read: if isConversationParticipant(resource.data);

      allow create: if isSignedIn() && emailVerified() &&
        request.resource.data.id == conversationId &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds[0] != request.resource.data.participantIds[1] &&
        isSocialEntityOperator(request.resource.data.requesterId, request.resource.data.participantTypes[request.resource.data.requesterId]) &&
        request.resource.data.requesterId in request.resource.data.participantIds &&
        request.resource.data.recipientId in request.resource.data.participantIds &&
        !isBlocked(request.resource.data.participantIds[0], request.resource.data.participantIds[1]);

      allow update: if isConversationParticipant(resource.data) &&
        resource.data.status != 'blocked';

      allow delete: if false;

      // ── MESSAGES — /conversations/{conversationId}/messages/{messageId} ────
      match /messages/{messageId} {
        allow read: if isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);

        allow create: if isSignedIn() && emailVerified() &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.status in ['accepted', 'pending_request'] &&
          request.resource.data.operatorUid == uid() &&
          isSocialEntityOperator(request.resource.data.senderId, request.resource.data.senderType) &&
          request.resource.data.senderId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.recipientId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          !isBlocked(request.resource.data.senderId, request.resource.data.recipientId) &&
          isString(request.resource.data.text) &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 2000;

        allow update: if isSignedIn() &&
          isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'conversationId', 'senderId', 'senderType', 'operatorUid', 'recipientId', 'text', 'createdAt']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['readBy', 'readAt', 'status']) ||
            !isSociallyRestricted(resource.data.recipientId, resource.data.senderId)
          );

        allow delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // SAVED PAYMENT METHODS — /paymentMethods/{uid}/savedMethods/{pmId} (Phase 6)
    // SERVER-AUTHORED ONLY: no raw card data stored, Stripe PM ID + metadata only
    // ══════════════════════════════════════════════════════════════════════════

    match /paymentMethods/{userId}/savedMethods/{pmId} {
      // Fan may read their own saved payment methods (display only)
      allow read: if isOwner(userId) && emailVerified();
      // No client may create, update, or delete (server only via callable)
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PRIVACY EXPORT REQUESTS — /privacyExportRequests/{uid}   (Phase 6)
    // Fan may create one export request; server processes it.
    // ══════════════════════════════════════════════════════════════════════════

    match /privacyExportRequests/{userId} {
      // Fan may read their own export request status
      allow read: if isOwner(userId) && emailVerified();
      // Fan may create their own request (server-validated rate limit in callable)
      // Client cannot set status, processedAt, or downloadUrl
      allow create: if isOwner(userId) && emailVerified() &&
        request.resource.data.uid == uid() &&
        request.resource.data.status == 'queued' &&
        !request.resource.data.keys().hasAny(['processedAt', 'downloadUrl', 'errorMessage']);
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CONSENT (top-level) — /consent/{consentId}   (Phase 5 compat)
    // NOTE: Phase 5 firestore_service.dart writes to /consent/{id} (flat).
    // Rules protect /users/{uid}/consents/{id} (subcollection). Both are valid.
    // This rule covers the flat collection used by Phase 5 server writes.
    // ══════════════════════════════════════════════════════════════════════════

    match /consent/{consentId} {
      // User may read their own consent records
      allow read: if isSignedIn() && resource.data.uid == uid();
      // Allow signed-in users to record their own consent
      allow create: if isSignedIn() && request.resource.data.uid == uid();
      allow update: if isSignedIn() && resource.data.uid == uid();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // VENUES — Phase 2 (geospatial fields added)
    // Public read for venue discovery (name, address, geohash5).
    // Writes are server-only (createVenue callable / Admin SDK).
    // ══════════════════════════════════════════════════════════════════════════

    match /venues/{venueId} {
      // Venues are publicly readable (no auth required for discovery map)
      allow read: if true;
      // All writes are server-only via createVenue callable
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CAMPAIGNS — Phase 7
    // Public read for active campaigns; server-only writes for all state.
    // ══════════════════════════════════════════════════════════════════════════

    match /campaigns/{campaignId} {
      // Active campaigns are publicly readable (discovery)
      // Draft/submitted visible to creator only
      allow read: if resource.data.status == 'active'
        || (isSignedIn() && resource.data.creatorId == uid());

      // All state transitions are server-only callables
      allow create, update, delete: if false;

      // Campaign updates: publicly readable on active campaigns
      match /updates/{updateId} {
        allow read: if get(/databases/$(database)/documents/campaigns/$(campaignId)).data.status == 'active'
          || (isSignedIn() && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.creatorId == uid());
        allow create, update, delete: if false;
      }

      // Contributions: fan reads own; creator reads all for their campaign; server writes
      match /contributions/{contributionId} {
        allow read: if isSignedIn() && (
          resource.data.fanUid == uid()
          || get(/databases/$(database)/documents/campaigns/$(campaignId)).data.creatorId == uid()
        );
        allow create, update, delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PAYOUTS — Phase 7 (server-only)
    // ══════════════════════════════════════════════════════════════════════════

    match /payouts/{payoutId} {
      // Recipient reads own payout records; finance staff reads all
      allow read: if isSignedIn() && (
        resource.data.recipientId == uid()
        || isFinanceStaff()
      );
      allow create, update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // LIVE CHECK-INS — /checkins/{performerId}
    //
    // The Crowdbeats discovery backbone. Publicly readable live sessions.
    // Writers must own the document (uid == performerId).
    //
    // Security guarantees (Phase 7):
    //   1. Owner-only writes — uid == request.auth.uid == performerId
    //   2. Email verification required to go live
    //   3. Lat/lng range validated: lat ∈ [-90,90], lng ∈ [-180,180]
    //   4. updatedAt must be request.time (server timestamp — prevents backdating)
    //   5. checkedInAt and type are immutable after creation
    //   6. Only isLive=true && visibility='public' docs are publicly readable
    //   7. No deletes: checkout = setDoc({isLive: false, checkedOutAt: ...})
    //   8. Admin/support staff can read all for dispute resolution
    // ══════════════════════════════════════════════════════════════════════════

    match /checkins/{performerId} {
      // ── Read ────────────────────────────────────────────────────────────────
      // Public read: only active, public, non-expired sessions are visible.
      // Staff can read any document for moderation purposes.
      allow read: if (
        resource.data.isLive == true &&
        resource.data.get('visibility', 'public') == 'public'
      ) || isOwner(performerId) || isUserSupportStaff();

      // ── Create ──────────────────────────────────────────────────────────────
      // Performer creates their own check-in document.
      allow create: if isOwner(performerId) && emailVerified() &&
        // Required fields
        request.resource.data.uid == performerId &&
        request.resource.data.performerName is string &&
        request.resource.data.performerName.size() >= 1 &&
        request.resource.data.performerName.size() <= 100 &&
        request.resource.data.type in ['artist', 'band'] &&
        request.resource.data.latitude is number &&
        request.resource.data.longitude is number &&
        // Coordinate range validation
        request.resource.data.latitude  >= -90  &&
        request.resource.data.latitude  <=  90  &&
        request.resource.data.longitude >= -180 &&
        request.resource.data.longitude <=  180 &&
        // isLive must be true on create
        request.resource.data.isLive == true &&
        // visibility must be a valid value
        request.resource.data.get('visibility', 'public') in ['public', 'followers_only', 'private'] &&
        // Server timestamp — prevents client backdating
        request.resource.data.updatedAt == request.time &&
        // No client-forged financial or moderation fields
        !request.resource.data.keys().hasAny([
          'totalTipsReceivedCents', 'platformRole', 'stripeAccountId',
          'suspendedAt', 'complianceHold', 'isBanned'
        ]);

      // ── Update ──────────────────────────────────────────────────────────────
      // Performer can update position, isLive, visibility, expiresAt, venueName.
      // checkedInAt and type are immutable (audit trail + anti-spoofing).
      allow update: if isOwner(performerId) && emailVerified() &&
        // Immutable fields after creation
        immutableOnUpdate(['uid', 'checkedInAt', 'type']) &&
        // Coordinate range (if position is being updated)
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['latitude', 'longitude']) ||
          (
            request.resource.data.latitude  >= -90  &&
            request.resource.data.latitude  <=  90  &&
            request.resource.data.longitude >= -180 &&
            request.resource.data.longitude <=  180
          )
        ) &&
        // visibility must remain valid if changed
        request.resource.data.get('visibility', 'public') in ['public', 'followers_only', 'private'] &&
        // Server timestamp on every update
        request.resource.data.updatedAt == request.time &&
        // No financial or admin field injections
        !request.resource.data.keys().hasAny([
          'totalTipsReceivedCents', 'platformRole', 'stripeAccountId',
          'suspendedAt', 'complianceHold', 'isBanned'
        ]);

      // ── Delete ───────────────────────────────────────────────────────────────
      // No hard deletes. Checkout = update({isLive: false}).
      // SUPER_ADMIN can force-delete stale/abusive documents via callable.
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // LIVE SESSIONS & SERVER-AUTHORITATIVE LOCATION (Phase 2, 6, & 7)
    // ══════════════════════════════════════════════════════════════════════════

    match /sessions/{sessionId} {
      // 1. Fan clients may read only approved public presence fields through bounded query shapes:
      //    Must be live and unexpired.
      // 2. The active creator (performer) may read their own session status (live, ended, etc.).
      // 3. User support staff may inspect session document metadata.
      allow read: if (
        resource.data.status == 'live' &&
        resource.data.endsAt > request.time
      ) || (
        isSignedIn() && resource.data.performerId == uid()
      ) || isUserSupportStaff();

      // 3. Public presence writes are strictly server-only. Clients cannot forge or mutate.
      allow write: if false;

      // 1. Private operational location telemetry — strictly Admin SDK only. Zero client read/write.
      match /private/{document=**} {
        allow read, write: if false;
      }

      // 6. Individual audience grants:
      //    - Granting fan can read own grant.
      //    - Active creator can read only if:
      //      a) Not revoked (revokedAt == null or absent)
      //      b) Not expired (expiresAt > request.time)
      //      c) Neither party has blocked the other
      //    - Server-authoritative writes only.
      match /audienceGrants/{grantId} {
        allow read: if isSignedIn() && (
          resource.data.fanUid == uid() || (
            resource.data.performerId == uid() &&
            (!('revokedAt' in resource.data) || resource.data.revokedAt == null) &&
            resource.data.expiresAt > request.time &&
            !isBlocked(resource.data.performerId, resource.data.fanUid)
          )
        );
        allow write: if false;
      }

      // 4. Subcollection private audience signals (if colocated under session):
      //    Readable only by the granting Fan. Creators never read directly.
      match /privateAudienceSignals/{signalId} {
        allow read: if isSignedIn() && resource.data.fanUid == uid();
        allow write: if false;
      }
    }

    // 4. Private audience signals (top-level):
    //    Readable only by the granting Fan and trusted backend. Creators never read directly.
    match /privateAudienceSignals/{signalId} {
      allow read: if isSignedIn() && resource.data.fanUid == uid();
      allow write: if false;
    }

    // 5. Creator audience zones:
    //    Server-only writes. Readable only by the authorized performer for the active session.
    //    Enforce unexpired bounds.
    match /audienceZones/{zoneId} {
      allow read: if isSignedIn() &&
        resource.data.performerId == uid() &&
        resource.data.expiresAt > request.time;
      allow write: if false;
    }

    // Check-in attempts:
    // Client cannot write. Caller or performer can inspect own attempt status.
    match /checkInAttempts/{attemptId} {
      allow read: if isSignedIn() && (
        resource.data.callerUid == uid() ||
        resource.data.performerId == uid()
      );
      allow write: if false;
    }

    // Location audit events:
    // Admin SDK only (legal retention class). Routine support/admin denied access to raw fan location.
    match /locationAuditEvents/{eventId} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // DEFAULT DENY — ALL OTHER PATHS
    // ══════════════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
