# Crowdbeats V2 — .gitignore

# ─── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnp
.pnp.js

# ─── TypeScript build outputs ─────────────────────────────────
dist/
# Note: DO NOT use bare 'lib/' here — it would ignore apps/mobile/lib/ (Flutter source).
# Scope to the packages that compile to lib/:
packages/contracts/lib/
packages/design-tokens/lib/
packages/web-sdk/lib/
packages/config/lib/
*.tsbuildinfo

# ─── Next.js ──────────────────────────────────────────────────
.next/
apps/web/.next/
apps/web/out/

# ─── Flutter / Dart ───────────────────────────────────────────
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/.packages
apps/mobile/pubspec.lock          # tracked intentionally for reproducibility
                                  # KEEP: pubspec.lock is important for reproducible builds

# ─── Firebase ─────────────────────────────────────────────────
.firebaserc                       # NEVER commit real project IDs
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
functions-debug.log
.runtimeconfig.json               # local emulator config with secrets
firebase/emulator-data/*.json     # runtime emulator data (committed stubs are ok)

# ─── Environment and secrets ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.p8
*.key
*.p12
*.keystore
service-account*.json
google-services.json              # committed only from David's explicit decision
GoogleService-Info.plist          # committed only from David's explicit decision
.secrets/

# ─── Android ──────────────────────────────────────────────────
apps/mobile/android/local.properties
apps/mobile/android/key.properties
apps/mobile/android/app/google-services.json

# ─── iOS ──────────────────────────────────────────────────────
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/Flutter.podspec
apps/mobile/ios/Flutter/Generated.xcconfig
apps/mobile/ios/Flutter/app.flx
apps/mobile/ios/Flutter/flutter_assets/
apps/mobile/ios/Runner.xcworkspace/xcuserdata/

# ─── Editor / OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json            # personal settings not committed
.vscode/*.code-workspace
*.sublime-project

# ─── Test / coverage ──────────────────────────────────────────
coverage/
.nyc_output/
lcov.info

# ─── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ─── Misc ─────────────────────────────────────────────────────
*.tgz
tmp/
scratch/
